{
  "name": "snaphunt",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web",
    "db:generate": "cd packages/infra && drizzle-kit generate",
    "db:migrate": "bun --env-file=.env packages/infra/scripts/migrate.ts",
    "deploy:api": "bash scripts/deploy-api.sh",
    "dev:web": "bun run --filter @snaphunt/web dev",
    "build:web": "bun run --filter @snaphunt/web build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.28",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.70.0",
    "@fal-ai/client": "1.10.1",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@mastra/core": "1.74.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.9.11",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.5"
  }
}
