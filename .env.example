# Gemma 4 31B IT via Google AI Studio (Gemini API)
GOOGLE_AI_API_KEY=
# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
# Supabase project URL
SUPABASE_URL=
# Supabase service role key (backend only, never exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Fal image-to-image generation
FAL_KEY=
# Supabase transaction pooler connection string (Project -> Connect). Percent-encode special characters in the password (e.g. ? -> %3F, @ -> %40).
DATABASE_URL=
# Nebius Token Factory (Qwen3.8-27B, primary vision model)
NEBIUS_API_KEY=
# Vision model id: nebius/Qwen/Qwen3.8-27B (default) or google/gemma-4-31b-it
VISION_MODEL=nebius/Qwen/Qwen3.8-27B
# Origin of the web app allowed to call the API (CORS). Local default shown.
WEB_ORIGIN=http://localhost:3000
# Base URL of the API, read by the web app only (not a secret). Local default shown.
NEXT_PUBLIC_API_URL=http://localhost:8787
